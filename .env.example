# WordPress target. HTTPS is required. Subdirectory installs are supported, e.g. https://example.org/wordpress.
WP_URL=https://site-one.example

# Recommended: a dedicated WordPress user with the Editor role.
WP_USERNAME=chatgpt-bridge

# Create this under WordPress Users -> Profile -> Application Passwords.
# Spaces are OK; the bridge removes them before authentication.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional default author for NEW posts/pages/custom items.
# A numeric WordPress user ID is most deterministic; an exact display name, nickname, or slug also works.
# The public byline still comes from that WordPress user's "Display name publicly as" profile setting.
DEFAULT_AUTHOR=SiteOne.lt
# When true, requests cannot substitute a different author_id.
ENFORCE_DEFAULT_AUTHOR=true

# Generate with: npm run generate-key
# Keep this secret. Put the SAME value into the GPT Action API-key settings.
BRIDGE_API_KEY=replace-with-a-random-64-character-hex-key

# Local listener. Loopback is enforced unless ALLOW_EXTERNAL_ACCESS=true is explicitly set.
HOST=127.0.0.1
PORT=8787
ALLOW_EXTERNAL_ACCESS=false

# Forwarded client-IP headers (CF-Connecting-IP / X-Forwarded-For) are ignored by default.
# If a trusted reverse proxy connects directly to the bridge, list its exact peer IP(s) here.
# Example for a local cloudflared process: TRUSTED_PROXY_IPS=127.0.0.1,::1
TRUSTED_PROXY_IPS=

# Stable Cloudflare Tunnel hostname used by the GPT Action.
PUBLIC_BASE_URL=https://wpbridge.site-one.example

# Safety default. Leave false until read/create/edit/workflow tests work correctly.
# This gates post/page/custom-item publish, unpublish, future scheduling, comment approval/hold, and public comment replies.
ALLOW_PUBLISH=false

# Separate safety gate for editing already-published content or its metadata.
# Leave false unless you intentionally want the bridge to change live items.
ALLOW_LIVE_EDITS=false

# Conservative limits. Base64 media uploads need a larger JSON request limit.
# 12 MB body allows roughly an 8 MB media file after base64 expansion.
MAX_BODY_BYTES=12000000
# Maximum raw-content characters returned by detail reads before windowing.
# Use content_offset/content_limit to read later portions of very large posts.
MAX_CONTENT_RESPONSE_CHARS=24000
MAX_MEDIA_BYTES=8000000
# Conversation source files may be larger before optional image-only WebP conversion.
MAX_SOURCE_IMAGE_BYTES=20000000
MAX_SOURCE_IMAGE_BATCH_BYTES=50000000
# Recommend optimization above either this byte size or the dimension below.
IMAGE_OPTIMIZE_THRESHOLD_BYTES=1500000
IMAGE_OPTIMIZE_MAX_DIMENSION=1920
IMAGE_OPTIMIZE_QUALITY=82
# DOCX/ZIP extraction limits (archives are never written to disk).
MAX_ARCHIVE_ENTRIES=1000
MAX_EXTRACTED_IMAGES=50
RATE_LIMIT_PER_MINUTE=120

# Duplicate-prevention store for create/upload/reply operations.
# Keep this on persistent local storage; plaintext idempotency keys are not written to disk.
IDEMPOTENCY_STORE_PATH=.data/idempotency.json
IDEMPOTENCY_RETENTION_HOURS=168
IDEMPOTENCY_MAX_RECORDS=500

# Privacy-filtered edit/activity history and guarded recovery store.
# Full post bodies, credentials, comments, and uploaded media bytes are never stored here.
ACTIVITY_STORE_PATH=.data/activity.json
ACTIVITY_RETENTION_DAYS=30
ACTIVITY_MAX_RECORDS=2000

# Prepared bulk editorial plans and chunked execution state.
BULK_OPERATION_STORE_PATH=.data/bulk-operations.json
BULK_OPERATION_RETENTION_HOURS=168
BULK_OPERATION_MAX_RECORDS=100
BULK_OPERATION_MAX_ITEMS=2000
BULK_OPERATION_LARGE_THRESHOLD=100
BULK_OPERATION_CHUNK_SIZE=25

# Read-only editorial audits use an overall deadline and bounded per-item concurrency.
AUDIT_DEADLINE_MS=15000
AUDIT_CONCURRENCY=4

# Optional custom-content allowlists (v1.8+).
# Only post types listed here can use the generic custom-post-type actions, including
# draft/review/schedule workflows and supported Gutenberg/revision operations.
# They must already be registered by WordPress with show_in_rest=true and use
# the standard wp/v2 REST controller. Never include post, page, or attachment.
# Example: CUSTOM_POST_TYPES=sermon,resource
CUSTOM_POST_TYPES=

# Optional REST-exposed custom-field allowlist.
# Format: post_type:key1,key2;other_type:key3,key4
# Core post/page and any CUSTOM_POST_TYPES entry may be used.
# The meta keys must already be registered in WordPress with show_in_rest=true;
# custom post types must also support "custom-fields".
# Example: CUSTOM_FIELD_ALLOWLIST=post:subtitle;page:hero_text;sermon:speaker,sermon_date
CUSTOM_FIELD_ALLOWLIST=

# Optional custom-taxonomy allowlist for custom post types.
# Format: post_type:taxonomy1,taxonomy2;other_type:taxonomy3
# Every post type must also be present in CUSTOM_POST_TYPES. Each taxonomy must
# already be registered by WordPress with show_in_rest=true, be associated with
# that post type, and use the standard wp/v2 taxonomy REST controller.
# Core category/post_tag remain handled by the dedicated category/tag actions.
# Example: CUSTOM_TAXONOMY_ALLOWLIST=sermon:series,speaker;resource:resource_topic
CUSTOM_TAXONOMY_ALLOWLIST=
