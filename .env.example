# WordPress target. HTTPS is required.
WP_URL=https://site-one.example

# Recommended: a dedicated WordPress user with the Editor role.
WP_USERNAME=chatgpt-bridge

# Create this under WordPress Users -> Profile -> Application Passwords.
# Spaces are OK; the bridge removes them before authentication.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Generate with: npm run generate-key
# Keep this secret. Put the SAME value into the GPT Action API-key settings.
BRIDGE_API_KEY=replace-with-a-random-64-character-hex-key

# Local listener. Leave HOST as 127.0.0.1 so it is not exposed directly to your LAN.
HOST=127.0.0.1
PORT=8787

# Stable Cloudflare Tunnel hostname used by the GPT Action.
PUBLIC_BASE_URL=https://wpbridge.site-one.example

# Safety default. Leave false until read/create/edit tests work correctly.
ALLOW_PUBLISH=false

# Conservative limits.
MAX_BODY_BYTES=1500000
RATE_LIMIT_PER_MINUTE=120
