# Copy to mcp/.env. Never commit the actual key file.
WPBRIDGE_SITE_ONE_KEY=
WPBRIDGE_SITE_ONE_CONTROL_KEY=
WPBRIDGE_SITE_TWO_KEY=
WPBRIDGE_MCP_TOKEN=
# WPBRIDGE_MCP_SITES_FILE=C:/path/to/sites.local.json
# For remote ChatGPT access, use an OAuth provider and HTTPS reverse proxy:
# WPBRIDGE_MCP_OAUTH_ISSUER=https://your-issuer.example/
# WPBRIDGE_MCP_OAUTH_AUDIENCE=https://mcp.example.com/mcp
# WPBRIDGE_MCP_OAUTH_SUBJECT=your-exact-user-subject
# WPBRIDGE_MCP_OAUTH_JWKS_URL=https://your-issuer.example/.well-known/jwks.json
# WPBRIDGE_MCP_PUBLIC_URL=https://mcp.example.com/mcp
