# Copy to mcp/.env. Never commit the actual key file.
WPBRIDGE_SITE_ONE_KEY=
WPBRIDGE_SITE_ONE_CONTROL_KEY=
WPBRIDGE_SITE_TWO_KEY=
WPBRIDGE_MCP_TOKEN=
# WPBRIDGE_MCP_SITES_FILE=C:/path/to/sites.local.json
# Optional, stdio only: folder whose files upload_local_media may upload.
# Tool calls pass paths relative to it. It must not be writable by untrusted
# users or processes: Windows has no no-follow open, so a writer could race checks.
# WPBRIDGE_MCP_UPLOAD_DIR=C:/path/to/wpbridge-uploads
# For remote access, use an OAuth provider and an HTTPS tunnel or reverse proxy
# (see MCP-SETUP.md section 4). The issuer must match the token iss exactly,
# including any trailing slash.
# WPBRIDGE_MCP_OAUTH_ISSUER=https://TENANT.eu.auth0.com/
# WPBRIDGE_MCP_OAUTH_AUDIENCE=https://mcp.example.com/mcp
# WPBRIDGE_MCP_OAUTH_SUBJECT=your-exact-user-subject
# WPBRIDGE_MCP_OAUTH_JWKS_URL=https://TENANT.eu.auth0.com/.well-known/jwks.json
# WPBRIDGE_MCP_PUBLIC_URL=https://mcp.example.com/mcp
# Optional OAuth settings (defaults shown). An empty scope turns the scope
# requirement off, for providers without custom scopes. The claim may be scp.
# WPBRIDGE_MCP_OAUTH_SCOPE=wpbridge:access
# WPBRIDGE_MCP_OAUTH_SCOPE_CLAIM=scope
# Asymmetric algorithms only; none and HS* are refused.
# WPBRIDGE_MCP_OAUTH_ALGORITHMS=RS256
# Optional HTTP throttle per client, applied before authentication.
# WPBRIDGE_MCP_RATE_LIMIT_BURST=30
# WPBRIDGE_MCP_RATE_LIMIT_PER_SECOND=5
