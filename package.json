{
  "name": "wpbridge-mcp",
  "version": "1.15.1",
  "private": true,
  "type": "module",
  "description": "Self-hosted multi-site WordPress MCP gateway, Codex plugin, and guarded WordPress bridge.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "mcp": "node mcp/server.js --stdio",
    "mcp:http": "node mcp/server.js --http",
    "check": "node scripts/check-syntax.mjs",
    "generate-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "render-openapi": "node scripts/render-openapi.mjs",
    "test": "node --test",
    "ci": "npm run check && npm run check:instructions && npm test && npm run render-openapi && npm run check:openapi",
    "check:instructions": "node scripts/check-instructions.mjs",
    "check:openapi": "node scripts/check-openapi.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "jose": "^6.2.12",
    "sharp": "0.35.4",
    "yaml": "2.9.0",
    "yauzl": "3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "yazl": "3.3.1"
  }
}
